# Sample environment file. Copy to `.env` (gitignored), fill in real values,
# then export before launching the app:
#
#   set -a; source .env; set +a; ./mvnw spring-boot:run
#
# Spring Boot does NOT auto-load `.env` files; the `source` step above is what
# makes these variables visible to the JVM via `${...}` placeholders in
# src/main/resources/application.properties.

# ----- SMTP for 2FA codes + password-reset links -----
# Without these, EmailService logs the email body to the app console
# instead of sending. The 2FA code shows up as `Your verification code is: NNNNNN`.
#
# Gmail example: generate an App Password at
# https://support.google.com/accounts/answer/185833 and paste it as MAIL_PASSWORD.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@warehouse.local

# ----- App base URL (used in password-reset email links) -----
APP_BASE_URL=http://localhost:8080
